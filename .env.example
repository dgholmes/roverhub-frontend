# Copy to .env and adjust. No secrets here -- there is no auth yet.

# false -> mockDataProvider (default). true -> RealDataProvider: live MQTT over
# WebSocket for telemetry/state/heartbeat/ack, REST to the backend for commands.
VITE_USE_REAL_BACKEND=false
VITE_MQTT_WS_URL=ws://localhost:9001
VITE_API_BASE_URL=http://localhost:8000

# Optional site filter. Leave unset to span every site (correct for a
# single-site deployment). Robots are discovered at runtime from the backend
# registry plus the bridges' retained MQTT registrations -- there is deliberately
# no VITE_ROBOT_ID, which used to pin the UI to one robot at build time.
VITE_SITE_ID=site-dev

# Per-robot MJPEG relay base URLs (stream_manager.py on each edge device),
# comma-separated robotId=url. Resolved per robot rather than one global URL, so
# the console can never show one robot's camera while another is selected --
# see src/lib/edgeVideo.ts. Same-LAN dev/test path only; production video is
# WebRTC via MediaMTX, which is not built. Leave unset if you have no edge
# device on the LAN -- the player shows its placeholder, which is correct.
#VITE_EDGE_VIDEO_BASE_URLS=rover-jetson=http://10.0.12.116:8090,rover-pi=http://10.0.12.4:8090
